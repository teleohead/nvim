# Credit goes to @gillescastel

global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

endglobal

# A box
snippet box "Box"
`!p snip.rv = '┌' + '─' * (len(t[1]) + 2) + '┐'`
│ $1 │
`!p snip.rv = '└' + '─' * (len(t[1]) + 2) + '┘'`
$0
endsnippet

# begin-end environment
snippet env "begin{} / end{}" b
\\begin{$1}
	$0
\\end{$1}
endsnippet

snippet enum "Enumerate" b
\begin{enumerate}
	\item $0
\end{enumerate}
endsnippet

snippet item "Itemize" b
\begin{itemize}
	\item $0
\end{itemize}
endsnippet

snippet desc "Description" b
\begin{description}
	\item[$1] $0
\end{description}
endsnippet

snippet par "Paragraph" b
\paragraph{$0}
endsnippet

# Inline math
snippet mk "Math" w
$${1}$`!p
if t[2] and t[2][0] not in [',', '.', '?', '-', ' ']:
    snip.rv = ' '
else:
    snip.rv = ''
`$2
endsnippet

# Display math
snippet dm "Math" w
\[
$1
\] $0
endsnippet

# Subscripts and superscripts
snippet '([A-Za-z])(\d)' "auto subscript" wr
`!p snip.rv = match.group(1)`_`!p snip.rv = match.group(2)`
endsnippet

snippet '([A-Za-z])_(\d\d)' "auto subscript2" wr
`!p snip.rv = match.group(1)`_{`!p snip.rv = match.group(2)`}
endsnippet

snippet sq "^2" i
^2
endsnippet

snippet cb "^3" i
^3
endsnippet

snippet inv "^-1" i
^{-1}
endsnippet

snippet compl "complement" i
^{c}
endsnippet

snippet || "Mathbin Vert" i
\mathbin\Vert
endsnippet

snippet td "superscript" i
^{$1}$0
endsnippet

# Fractions
snippet // "Fraction" i
\\frac{$1}{$2}$0
endsnippet

# Bold, emph, and tt
snippet bf "Bold" w
\textbf{$0}
endsnippet

snippet emph "Emph" w
\emph{$0}
endsnippet

snippet tt "Code" w
\texttt{$0}
endsnippet

snippet vbf "Bold code" w
\textbf{\texttt{$0}}
endsnippet

snippet mrm "Mathrm" w
\mathrm{$0}
endsnippet

snippet gcd "Gcd" i
\mathrm{gcd}($0)
endsnippet

snippet sqrt "Square Root" w
\sqrt{$0}
endsnippet

snippet it "Bullet" w
\item 
endsnippet

snippet chap "Chapter" b
\chapter{$0}
endsnippet

snippet sec "Section" b
\section{$0}
endsnippet

snippet sub "Subsection" b
\subsection{$0}
endsnippet

snippet subs "Subsubsection" b
\subsubsection{$0}
endsnippet

snippet thm "Theorem" b
\begin{thm}
	$0
\end{thm}
endsnippet

snippet prop "Proposition" b
\begin{prop}
	$0
\end{prop}
endsnippet

snippet lem "Lemma" b
\begin{lem}
	$0
\end{lem}
endsnippet

snippet eg "Example" b
\begin{eg}
	$0
\end{eg}
endsnippet

snippet defn "Definition" b
\begin{defn}
	$0
\end{defn}
endsnippet

snippet set "Set" i
\\{ $0 \\}
endsnippet

snippet != "Neq" i
\neq
endsnippet

snippet -> "rightarrow" i
\rightarrow 
endsnippet

snippet => "Rightarrow" i
\Rightarrow 
endsnippet


snippet ab "LRangle" w
\langle $0 \rangle
endsnippet

snippet mbf "Mathbf" i
\mathbf{$0}
endsnippet

snippet mbb "Mathbb" i
\mathbb{$0}
endsnippet

snippet mbbr "Mathbb R" i
\mathbb{R}
endsnippet

snippet mbbq "Mathbb Q" i
\mathbb{Q}
endsnippet

snippet mbbn "Mathbb N" i
\mathbb{N}
endsnippet

snippet pr "Pr" i
\mathrm{Pr}[$0]
endsnippet

snippet mod "mod" w
\bmod{$0}
endsnippet

snippet hat "hat" w
\hat{$0}
endsnippet

snippet ol "overline" w
\overline{$0}
endsnippet

snippet timestamp "Timestamp"
\emph{Timestamp - `date +%F`}
endsnippet

snippet verb "Inline Verbatim" w
\verb|$0|
endsnippet

snippet * "Aterisk" i
^{*}
endsnippet

snippet | "Div" w
\mathbin\vert
endsnippet
